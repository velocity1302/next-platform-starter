{
  "name": "maschine-coach-agent",
  "version": "1.0.1",
  "description": "Lokale desktop companion-app voor Native Instruments Maschine 3",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && cp -r src/renderer/*.html src/renderer/*.css dist/renderer/",
    "start": "npm run build && electron dist/main.js",
    "dev": "tsc -w",
    "start:web": "echo Open http://localhost:3000/maschine-coach-agent from repo root",
    "dist:win": "echo Run on Windows PC after npm install: npx electron-builder --win",
    "dist:mac": "echo Run on macOS PC after npm install: npx electron-builder --mac",
    "install:macos-sequoia": "./scripts/install-macos-sequoia.sh"
  },
  "dependencies": {
    "electron-store": "^10.1.0",
    "midi-writer-js": "^3.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "electron": "^36.0.0",
    "typescript": "^5.8.3",
    "electron-builder": "^24.13.3"
  },
  "engines": {
    "node": ">=20"
  }
}